apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: <CA_CERTIFICATE_DATA>
    server: https://<KUBERNETES_API_SERVER_ADDRESS>
  name: example-cluster-name
contexts:
- context:
    cluster: example-cluster-name
    user: example-user-name
  name: example-context-name
current-context: example-context-name
users:
- name: example-user-name
  user:
    token: <USER_AUTHENTICATION_TOKEN>
