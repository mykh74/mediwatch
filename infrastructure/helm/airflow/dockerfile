# Use the official version that matches your current Helm deployment
FROM apache/airflow:3.1.7 

# Switch to root to install system dependencies (if needed)
USER root

# Switch back to the airflow user to install Python packages
USER airflow

# Install the Kubernetes provider and any other libraries you need
RUN pip install --no-cache-dir \
    apache-airflow-providers-cncf-kubernetes==10.12.4 \
    kubernetes==35.0.0